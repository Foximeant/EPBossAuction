diff --git a/EPBossAuction/theme.lua b/EPBossAuction/theme.lua
index efe831e..e999421 100644
--- a/EPBossAuction/theme.lua
+++ b/EPBossAuction/theme.lua
@@ -13,6 +13,28 @@ local auction = EPBossAuction
 -- SkinButton — у них свой скин, см. комментарий там же.
 -- ============================================================
 
+-- Все вторичные окна аддона (отчёты, справка, «Что нового?», окно лута, BiS-окна и т.д.)
+-- создаются через SetupWindow: главное окно лежит в страте DIALOG на уровне MAIN_FRAME_LEVEL,
+-- поэтому окна должны быть в той же страте, но на уровне выше, иначе они прячутся под ним.
+-- Вызывать сразу после CreateFrame, ДО создания дочерних элементов: уровни детей
+-- считаются от уровня родителя в момент их создания.
+-- SetToplevel: клик по окну поднимает его над другими окнами аддона.
+-- Если на каком-то клиенте большие уровни ведут себя странно, достаточно поменять эту константу.
+auction.MAIN_FRAME_LEVEL = 100
+auction.WINDOW_FRAME_LEVEL = 200
+
+-- Дополнительно при каждом Show() окно поднимается Raise(): движок ставит его над всеми
+-- окнами этой страты, поэтому окно оказывается поверх главного, даже если уровни по какой-то
+-- причине не сработали (например, окно построено и показано раньше, чем применились константы).
+-- Raise только поднимает окно вместе с его детьми; strata не трогаем: выпадающие списки
+-- (UIDropDownMenu) в окне лута и отчётах лежат в DIALOG и должны оставаться над своим окном.
+function auction:SetupWindow(frame)
+    frame:SetFrameStrata("DIALOG")
+    frame:SetFrameLevel(auction.WINDOW_FRAME_LEVEL)
+    frame:SetToplevel(true)
+    hooksecurefunc(frame, "Show", function(f) f:Raise() end)
+end
+
