+    empty:SetTextColor(0.6, 0.6, 0.6)
+    empty:SetText("Избранных предметов пока нет.\nОтметьте нужные звёздочкой справа от названия в таблице на вкладке «Ставки»: они появятся здесь, со всех боссов сразу.")
+    self.favEmpty = empty
