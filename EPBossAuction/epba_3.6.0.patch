+    self.bisPanel = panel
+
+    -- Шапка: «Назад», хлебные крошки, «Импорт»
+    self.bisBackBtn = MakeBtn(panel, "< Назад", 70, "TOPLEFT", 6, -6, GoBack)
+    local crumb = panel:CreateFontString(nil, "OVERLAY", "GameFontNormal")
